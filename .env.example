# Local development environment

# --- Login / NextAuth ---
NEXTAUTH_SECRET=replace-with-a-long-random-secret
# Optional locally. Leave unset so NextAuth can infer localhost/LAN host.
# In Vercel production, configure NEXTAUTH_SECRET in Project Settings.

# --- Supabase ---
# Project URL: Supabase Dashboard -> Settings -> API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Server-only secret key. Never expose this in client-side code.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY

# --- Automation 2 / n8n ---
# Server-side webhook used by the dashboard's Upload Invoice / Receipt button.
N8N_INVOICE_UPLOAD_WEBHOOK_URL=https://YOUR_N8N_HOST/webhook/topsail/invoice-upload
# n8n uses these server-side environment variables for the imported Automation 2 workflow.
# Configure them in n8n, not in the browser.
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Automation 4 - Homebase payroll CSV intake
N8N_LABOR_UPLOAD_WEBHOOK_URL=https://n8n-97af.srv1958066.hstgr.cloud/webhook-test/topsail/automation4/labor-upload

# Automation 1 - BentoBox email is ingested by n8n from the Gmail business inbox.
# This optional webhook remains as a manual fallback for an email that cannot be parsed.
N8N_REVIEW_MANUAL_WEBHOOK_URL=https://n8n-97af.srv1958066.hstgr.cloud/webhook/topsail/review-manual

# Automation 1 - manual BentoBox email sending. The n8n webhook should send the
# supplied `to`, `subject`, and `body` using the connected business Gmail account.
N8N_REVIEW_MANUAL_SEND_WEBHOOK_URL=https://YOUR_N8N_HOST/webhook/topsail/review-manual-send

# Automation 5 - weekly royalty + third-party delivery compliance
N8N_AUTOMATION5_N8N_URL=https://YOUR_N8N_HOST
N8N_WEBHOOK_SHARED_SECRET=
